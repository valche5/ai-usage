# Copie ce fichier vers .env. Ne commite jamais .env.
AI_USAGE_PASSWORD=change-moi-avec-un-mot-de-passe-long
# Optionnel : jeton Bearer dédié (app Android / GET /api/reports).
# Sans cette variable, Authorization: Bearer <AI_USAGE_PASSWORD> est accepté.
# AI_USAGE_API_TOKEN=
# Génération : openssl rand -base64 32
AI_USAGE_ENCRYPTION_KEY=remplace-moi
AI_USAGE_ADDR=:8080
AI_USAGE_DATA_DIR=/data
AI_USAGE_REFRESH_INTERVAL=1m
AI_USAGE_SESSION_TTL=168h
TZ=Europe/Paris
